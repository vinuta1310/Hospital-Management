<%= form_with model: @patient do |f| %>
  <% if @patient.errors.any? %>
    <div style= "color: red">
      <ul>
        <% @patient.errors.full_messages.each do |error| %>
          <li> <%= error %> </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name %> <br>
    <%= f.text_field :name, style: "width: 300px" %>
  </div>

  <div>
    <%= f.label :age %> <br>
    <%= f.text_field :age, style: "width: 300px" %>
  </div>

  <div>
    <%= f.label :gender %> <br>
    <%= f.text_field :gender, style: "width: 300px" %>
  </div>
  
  <div style = "marigin-top:8px">
    <%= f.submit %>
  </div
<% end %>

  


