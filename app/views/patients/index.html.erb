<p style="color: green"><%= notice %></p>

<% content_for :title, "Hospital Management System" %>

<h1>Patient</h1>

<%= link_to "New Patient", new_patient_path%>

<table border= 1>
  <thead>
    <tr>
      <th> Name </th>
      <th> Age </th>
      <th> Gender </th>
    </tr>
  </thead>
  <tbody>
    <% @patients.each do |patient| %>
      <tr>
        <td> <%= patient.name %> </td>
        <td> <%= patient.age %> </td>
        <td> <%= patient.gender %> </td>
        <td>
          <%= link_to "Show", patient_path(patient)%>
          <%= link_to "Edit", edit_patient_path(patient)%>
          <%= link_to "Delete", patient_path(patient), data: { turbo_method: :delete, turbo_confirm: "Are your sure?"} %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
