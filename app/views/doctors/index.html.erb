<p style="color: green"><%= notice %></p>

<% content_for :title, "Hospital Management System" %>

<h1>Doctor</h1>

<%= link_to "New Doctor", new_doctor_path %>


<table border= 1>
  <thead>
    <tr>
      <th> Doctor's Name </th>
      <th> Specialization </th>
    </tr>
  </thead>
  <tbody>
    <% @doctors.each do |doctor| %>
      <tr>
        <td> <%= doctor.doctor_name %> </td>
        <td> <%= doctor.specialization %> </td>
        <td>
          <%= link_to "Show", doctor_path(doctor) %>
          <%= link_to "Edit", edit_doctor_path(doctor) %>
          <%= link_to "Delete", doctor_path(doctor), data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
